# 复制为 .env 后填写

# 用户在浏览器里访问的地址（不带结尾 /）。
# 飞书后台「安全设置 → 重定向 URL」要填：<这个地址>/auth/callback
HTMLSHARE_PUBLIC_URL=https://share.example.com

# 会话签名密钥，至少 32 个字符，生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HTMLSHARE_SECRET_KEY=

# 飞书企业自建应用的凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=

# 可选：只允许这个企业的账号登录。先留空登录一次，docker compose logs 里的 "登录 ... tenant_key=xxx" 就是
FEISHU_TENANT_KEY=

# 可选参数
# HTMLSHARE_DEFAULT_EXPIRE_DAYS=30   # 发布时不指定过期天数的默认值，0 = 永不过期
# HTMLSHARE_MAX_EXPIRE_DAYS=365
# HTMLSHARE_MAX_UPLOAD_MB=20
# HTMLSHARE_SESSION_DAYS=7           # 浏览器登录有效天数
# HTMLSHARE_COOKIE_SECURE=           # 默认按 PUBLIC_URL 是否 https 自动判断

# docker compose 端口绑定（生产建议绑定到内网网卡 IP，前面再挂 Nginx/Caddy 做 HTTPS）
HTMLSHARE_BIND=0.0.0.0
HTMLSHARE_PORT=8080

# 国内拉 PyPI 慢可以换镜像（构建镜像时使用）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# 仅本地开发：不经过飞书、随便填邮箱就能登录。生产环境绝对不能开！
# HTMLSHARE_DEV_FAKE_LOGIN=1
